{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/app.css",
    "functions": ["cn", "clsx", "cva"]
  },
  "ignorePatterns": [
    "build",
    "coverage",
    ".claude",
    ".output",
    ".tanstack",
    "pnpm-lock.yaml"
  ]
}
