/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=()

/static/*
  Cache-Control: public, max-age=31556952, immutable

/assets/*
  Cache-Control: public, max-age=31556952, immutable
