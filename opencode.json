{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "tailwindcss": {
      "command": ["tailwindcss-language-server", "--stdio"],
      "extensions": [".tsx", ".ts", ".jsx", ".js", ".css"],
      "initialization": {
        "settings": {
          "tailwindCSS": {
            "experimental": {
              "classRegex": [
                "cn\\(([^)]*)\\)",
                "clsx\\(([^)]*)\\)",
                "cva\\(([^)]*)\\)"
              ]
            }
          }
        }
      }
    }
  }
}
